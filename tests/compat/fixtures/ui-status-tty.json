      "lines": "173-228"
    },
    {
      "revision": "cc40679d267165aecfa569128438bb55fe910268",
      "path": "lib/confctl/machine_status.rb",
      "lines": "36-130"
    }
  ],
  "argv": [
    "status",
    "-g",
    "none",
    "beta"
  ],
  "env": {
    "CONFCTL_TTY": ""
  },
  "stdin": "y\n",
  "tty": true,
  "files": {
    "flake.nix": {
      "text": "{ outputs = _: {}; }\n"
    },
    "cluster/cluster.nix": {
      "text": "[]\n"
    },
    "configs/node/.keep": {
      "text": ""
    },
    "fixtures/machines.json": {
      "text": "{\"alpha/site\": {\"name\": \"alpha/site\", \"key\": \"ka\", \"clusterName\": \"alpha/site\", \"carrier\": null, \"alias\": null, \"metaConfig\": {\"managed\": true, \"spin\": \"vpsadminos\", \"tags\": [\"node\", \"east\"], \"host\": {\"target\": \"alpha.example\", \"port\": 22}, \"netboot\": {\"enable\": true}, \"healthChecks\": {}, \"custom\": {\"bool\": false, \"empty\": \"\", \"array\": [\"a\", \"b\"], \"null\": null, \"count\": 3}, \"carrier\": {\"enable\": false, \"machines\": []}}}, \"beta\": {\"name\": \"beta\", \"key\": \"kb\", \"clusterName\": \"beta\", \"carrier\": null, \"alias\": null, \"metaConfig\": {\"managed\": true, \"spin\": \"nixos\", \"tags\": [\"web\"], \"host\": {\"target\": \"beta.example\", \"port\": 2222}, \"netboot\": {\"enable\": false}, \"healthChecks\": {}, \"custom\": {\"bool\": false, \"empty\": \"\", \"array\": [\"a\", \"b\"], \"null\": null, \"count\": 3}, \"carrier\": {\"enable\": false, \"machines\": []}}}, \".hidden\": {\"name\": \".hidden\", \"key\": \"kh\", \"clusterName\": \".hidden\", \"carrier\": null, \"alias\": null, \"metaConfig\": {\"managed\": false, \"spin\": \"vpsadminos\", \"tags\": [\"node\"], \"host\": {\"target\": \"hidden.example\", \"port\": 22}, \"netboot\": {\"enable\": true}, \"healthChecks\": {}, \"custom\": {\"bool\": false, \"empty\": \"\", \"array\": [\"a\", \"b\"], \"null\": null, \"count\": 3}, \"carrier\": {\"enable\": false, \"machines\": []}}}, \"alpha/carried\": {\"name\": \"alpha/carried\", \"key\": \"kc\", \"clusterName\": \"alpha/carried\", \"carrier\": \"alpha/site\", \"alias\": \"guest/one\", \"metaConfig\": {\"managed\": true, \"spin\": \"vpsadminos\", \"tags\": [\"node\"], \"host\": {\"target\": \"own.example\", \"port\": 22}, \"netboot\": {\"enable\": true}, \"healthChecks\": {}, \"custom\": {\"bool\": false, \"empty\": \"\", \"array\": [\"a\", \"b\"], \"null\": null, \"count\": 3}, \"carrier\": {\"enable\": false, \"machines\": []}}}}"
    },
    "fixtures/settings.json": {
      "text": "{\"list\": {\"columns\": [\"name\", \"spin\", \"managed\", \"host.target\"]}, \"nix\": {\"maxJobs\": \"auto\", \"impureEval\": true, \"legacyNixPath\": false}}"
    },
    "fixtures/module-options.json": {
      "text": "[{\"name\": \"cluster.<name>.spin\"}, {\"name\": \"cluster.<name>.host.target\"}, {\"name\": \"unrelated\"}]"
    }
  },
  "rules": [
    {
      "tool": "nix",
      "contains": ".#confctl.settings",
      "stdout": "{\"list\": {\"columns\": [\"name\", \"spin\", \"managed\", \"host.target\"]}, \"nix\": {\"maxJobs\": \"auto\", \"impureEval\": true, \"legacyNixPath\": false}}\n"
    },
    {
      "tool": "nix",
      "contains": ".#confctl.machinesJson",
      "stdout": "[{\"outputs\":{\"out\":\"${ROOT}/fixtures/machines.json\"}}]\n"
    },
    {
      "tool": "nix",
      "contains": ".#confctl.moduleOptions",
      "stdout": "[{\"name\": \"cluster.<name>.spin\"}, {\"name\": \"cluster.<name>.host.target\"}, {\"name\": \"unrelated\"}]\n"
    },
    {
      "tool": "nix",
      "contains": ".#confctl.machineKeys",
      "stdout": "{\"alpha/site\": \"ka\", \"beta\": \"kb\", \".hidden\": \"kh\", \"alpha/carried\": \"kc\"}\n"
    },
    {
      "tool": "nix",
      "contains": ".#confctl.inputsInfo.ka",
      "stdout": "{\"nixpkgs\": {\"rev\": \"123456789\", \"url\": \"local:fixture\"}, \"extra\": {\"rev\": null}}\n"
    },
    {
      "tool": "nix",
      "contains": ".#confctl.inputsInfo.kb",
      "stdout": "{\"nixpkgs\": {\"rev\": \"123456789\", \"url\": \"local:fixture\"}, \"extra\": {\"rev\": null}}\n"
    },
    {
      "tool": "nix",
      "contains": ".#confctl.inputsInfo.kh",
      "stdout": "{\"nixpkgs\": {\"rev\": \"123456789\", \"url\": \"local:fixture\"}, \"extra\": {\"rev\": null}}\n"
    },
    {
      "tool": "nix",
      "contains": ".#confctl.inputsInfo.kc",
      "stdout": "{\"nixpkgs\": {\"rev\": \"123456789\", \"url\": \"local:fixture\"}, \"extra\": {\"rev\": null}}\n"
    },
    {
      "tool": "ssh",
      "host": "alpha.example",
      "contains": "cat /proc/uptime",
      "stdout": "86400.0 12.0\n"
    },
    {
      "tool": "ssh",
      "host": "alpha.example",
      "contains": "bash --norc",
      "stdout": "/nix/store/fixture-system\n",
      "read_stdin": true
    },
    {
      "tool": "ssh",
      "host": "alpha.example",
      "contains": "cat /etc/confctl/inputs-info.json",
      "stdout": "{\"nixpkgs\": \"123456789\", \"old\": \"oldrev\"}\n"
    },
    {
      "tool": "ssh",
      "host": "alpha.example",
      "contains": "/machine.json",
      "stdout": "{\"inputs-info\": {\"nixpkgs\": \"changedrev\", \"old\": \"oldrev\"}}\n"
    },
    {
      "tool": "ssh",
      "host": "beta.example",
      "contains": "cat /proc/uptime",
      "stdout": "100.0 1.0\n"
    },
    {
      "tool": "ssh",
      "host": "beta.example",
      "contains": "bash --norc",
      "stdout": "/nix/store/fixture-system\n",
      "read_stdin": true
    },
    {
      "tool": "ssh",
      "host": "beta.example",
      "contains": "cat /etc/confctl/inputs-info.json",
      "stdout": "{\"nixpkgs\": \"123456789\", \"old\": \"oldrev\"}\n"
    },
    {
      "tool": "ssh",
      "host": "beta.example",
      "contains": "/machine.json",
      "stdout": "{\"inputs-info\": {\"nixpkgs\": \"changedrev\", \"old\": \"oldrev\"}}\n"
    }
  ],
  "expected": "../expected/ui-status-tty.json",
  "normalize": {
    "root_fields": [
      "stdout",
      "stderr",
      "events.cwd",
      "events.argv",
      "events.stdin",
      "events.env.PWD",
      "events.stdout",
      "events.stderr"
    ],
    "volatile_fields": [
      "events.pid",
      "events.start_ns",
      "events.end_ns",
      "wall_ns",
      "user_ns",
      "system_ns",
      "max_rss_kb"
    ],
    "concurrent_events": false,
    "run_root_fields": [
      "events.env.HOME",
      "events.env.TMPDIR",
      "events.env.COMPAT_CASE"
    ],
    "log_fields": [
      "filename-time",
      "command-uuid",
      "gli-parent-address",
      "process-duration",
      "config-root"
    ],
    "independent_ssh": [
      {
        "name": "beta",
        "steps": [
          {
            "tool": "ssh",
            "host": "beta.example",
            "contains": "cat /proc/uptime"
          },
          {
            "tool": "ssh",
            "host": "beta.example",
            "contains": "bash --norc",
            "stdin_contains": "realpath /nix/var/nix/profiles/system\n"
          },
          {
            "tool": "ssh",
            "host": "beta.example",
            "contains": "cat /etc/confctl/inputs-info.json"
          }
        ]
      }
    ]
  },
  "deadline_ms": 30000,
  "causal": [
    {
      "before": {
        "tool": "nix"
      },
      "after": {
        "tool": "ssh"
      }
    }
  ],
  "extensions": false
}
